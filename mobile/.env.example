# API URL configuration for Expo Mobile App
#
# Choose the URL that matches your development environment:
# - Physical device (Expo Go): http://<YOUR_COMPUTER_LAN_IP>:4000 (e.g. http://192.168.1.12:4000)
# - Android Emulator:          http://10.0.2.2:4000
# - iOS Simulator:             http://localhost:4000
# - Web browser:               http://localhost:4000

EXPO_PUBLIC_API_URL=http://192.168.1.12:4000
